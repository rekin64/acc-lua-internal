        "name": "gap",
        "note": "Pre-drop gap: only riser tail / reverse swell."
      },
      {
        "t": 6.24,
        "name": "drop",
        "note": "Full groove: kick 4/4, clap 2 & 4, open hats offbeat, sidechained rolling bass, chord stabs. Fm9 (3 beats) -> Dbmaj7 (2) -> Eb (2)."
      },
      {
        "t": 9.6,
        "name": "montage",
        "note": "Drop continues + 16th hats + extra perc, accents on cut hits. Fm9 -> Db -> Eb -> Cm7, one chord per beat pair."
      },
      {
        "t": 12,
        "name": "break",
        "note": "Everything cuts except short riser / reverse swell into the outro."
      },
      {
        "t": 12.48,
        "name": "outro",
        "note": "Final impact, wide warm sustained chord (Dbmaj9 -> Abmaj9 / resolve bright), no drums. Tail rings out, clean fade to silence at 15.00."
      }
