# ─────────────────────────────────────────────────────────────
# Copiez ce fichier en « .env » puis complétez-le.
# Ne partagez JAMAIS le fichier .env : il donne accès à votre compte.
# ─────────────────────────────────────────────────────────────

# Identifiants API de votre compte Telegram (https://my.telegram.org → API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Jeton du bot de contrôle, fourni par @BotFather
BOT_TOKEN=1234567890:AAAbbbCCCdddEEEfffGGGhhhIIIjjjKKKll

# Votre identifiant Telegram (nombre), donné par @userinfobot.
# Seul ce compte pourra utiliser le bot.
OWNER_ID=123456789

# ── Options (facultatives) ───────────────────────────────────

# Numéro de téléphone du compte, au format international (sinon il est demandé à la connexion)
# PHONE=+33612345678

# Secondes d'attente entre deux groupes (minimum 5, conseillé 10 ou plus)
SEND_DELAY_SECONDS=10

# Heures minimum avant de republier dans un même groupe (0 = pas de limite)
REPOST_COOLDOWN_HOURS=24

# true = mode test permanent : le bot vérifie tout mais ne publie jamais rien
TEST_MODE=false

# Dossier des données locales (session, base, image de l'annonce)
# DATA_DIR=data
